{
  "name": "ode-menu",
  "version": "1.0.0",
  "private": true,
  "description": "Ode — website, menu and admin panel",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "import": "node scripts/import-kovzy.mjs",
    "reset": "node scripts/reset.mjs",
    "build:netlify": "node scripts/netlify-build.mjs",
    "build:static": "node scripts/netlify-build.mjs",
    "cf:dev": "wrangler dev"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.12",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "serverless-http": "^4.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "wrangler": "^4.169.0"
  },
  "overrides": {
    "iconv-lite": "0.6.3"
  }
